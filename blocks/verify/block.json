{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "events-certificates/verify",
	"title": "Check a certificate",
	"category": "widgets",
	"icon": "awards",
	"description": "A form to open a certificate by its code.",
	"keywords": [
		"certificate",
		"code",
		"verify"
	],
	"textdomain": "events-certificates",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "evcert-blocks-editor",
	"style": "file:./style.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
