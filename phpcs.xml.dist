<?xml version="1.0"?>
<ruleset name="Events Certificate">
	<description>WordPress Coding Standards for Events Certificate.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/vendor-prefixed/*</exclude-pattern>
	<!-- Build scripts run from the CLI, outside WordPress, and don't ship (.distignore). -->
	<exclude-pattern>/bin/*</exclude-pattern>
	<!-- Generated by bin/build-signer.mjs. -->
	<exclude-pattern>/build-signer/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!-- Generated by @wordpress/build (routes/ → build/). -->
	<exclude-pattern>/build/*</exclude-pattern>
	<!-- Plans and spike scripts: not shipped (.distignore). -->
	<exclude-pattern>/docs/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="events-certificate"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="evcert"/>
				<element value="EventsCertificate"/>
			</property>
		</properties>
	</rule>

	<!-- PHPUnit needs *Test.php files; test method names describe themselves.
	     bin/release.php is a dev tool with a fixed name (the wp-release-command pattern), not shipped. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/php/*Test.php</exclude-pattern>
	</rule>
	<!-- block.json asset files keep WordPress's name (<script>.asset.php). -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/blocks/*/*.asset.php</exclude-pattern>
	</rule>
</ruleset>
